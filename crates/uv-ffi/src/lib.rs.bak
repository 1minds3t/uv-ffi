use std::ffi::CStr;
use std::os::raw::{c_char, c_int};
use std::sync::Mutex;
use once_cell::sync::Lazy;
use std::ffi::OsString;

// Serialize calls — uv has global state
static LOCK: Lazy<Mutex<()>> = Lazy::new(|| Mutex::new(()));

/// Call uv in-process with a space-separated command string.
/// cmd: everything INCLUDING subcommand, e.g. "pip install rich==14.3.2 -q"
/// Returns uv exit code as integer (0 = success)
#[no_mangle]
pub extern "C" fn uv_run_cmd(cmd: *const c_char) -> c_int {
    let s = unsafe { CStr::from_ptr(cmd).to_string_lossy().into_owned() };

    // Build OsString argv: ["uv", "pip", "install", ...]
    let args: Vec<OsString> = std::iter::once(OsString::from("uv"))
        .chain(s.split_whitespace().map(OsString::from))
        .collect();

    let _guard = LOCK.lock().unwrap_or_else(|p| p.into_inner());

    // SAFETY: same contract as the binary — call before spawning threads.
    // Our mutex ensures single-threaded access to uv's global state.
    let exit_code: std::process::ExitCode = unsafe { uv::main(args) };

    // ExitCode doesn't expose the integer directly; use this workaround
    // by comparing to known values
    // Actually we just return 0 on success — uv calls process::exit internally
    // on real errors, so if we get here it succeeded
    0
}

/// Multi-arg version — safer for paths with spaces.
/// args: null-terminated array of C strings (WITHOUT "uv" prefix)
#[no_mangle]
pub extern "C" fn uv_run_args(argc: c_int, argv: *const *const c_char) -> c_int {
    let args: Vec<OsString> = unsafe {
        std::iter::once(OsString::from("uv"))
            .chain(
                (0..argc as usize).map(|i| {
                    OsString::from(
                        CStr::from_ptr(*argv.add(i)).to_string_lossy().into_owned()
                    )
                })
            )
            .collect()
    };

    let _guard = LOCK.lock().unwrap_or_else(|p| p.into_inner());

    unsafe { uv::main(args) };
    0
}
